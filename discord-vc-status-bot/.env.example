# Bot token from the Discord Developer Portal (required)
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: numeric ID of the voice channel whose name shows who is in VC.
# Leave empty to use the first voice channel of the server.
STATUS_CHANNEL_ID=

# Optional: minimum seconds between channel renames (default 2).
UPDATE_DELAY_SECONDS=2

# Optional: log verbosity (DEBUG, INFO, WARNING). Default INFO.
LOG_LEVEL=INFO
